<?php

/**
 * Implements hook_menu().
 */
function fbl_menu() {
  $items['admin/config/people/fbl'] = array(
    'title' => 'Field based login',
    'description' => 'Configurations for Field based login',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('_fbl_configuration'),
    'access arguments' => array('administer field based login'),
    'file' => 'includes/fbl.admin.inc',
  );
  $items['admin/config/people/fbl/default'] = array(
    'title' => 'Field Based Login',
    'description' => 'Configurations for Field Based Login',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => 1,
  );
  return $items;
}

/**
 * Implements hook_permission().
 */
function fbl_permission() {
  return array(
    'administer field based login' => array(
      'title' => t('Administer Field Based Login'),
      'description' => t('Perform administrative tasks on field based login module'),
    ),
  );
}

/**
 * Implement hook_form_alter().
 *
 */
function fbl_form_alter(&$form, $form_state, $form_id) {
  if ($form_id == 'user_login_block' || $form_id == 'user_login') {
    $form['#validate'] = fbl_login_default_validators();
    $field_based_login = variable_get('field_based_login', array());
    if (!empty($field_based_login['label'])) {
      $form['name']['#title'] = $field_based_login['label'];
    }
  }
}

/*
 * Callback function for user_login validator.
 */
function fbl_login_default_validators() {
  return array(
    'fbl_login_name_validate',
    'user_login_name_validate',
    'user_login_authenticate_validate',
    'user_login_final_validate'
  );
}

/*
 * Custom validate function to check custom user field records.
 */
function fbl_login_name_validate($form, &$form_state) {

  $field_based_login = variable_get('field_based_login', array());
  // If configuration not yet set, then allow users to login by username
  $allow_user_login_by_name = isset($field_based_login['allow_user_name']) ? $field_based_login['allow_user_name'] : 1;
  $allow_user_login_by_email = $field_based_login['allow_user_email'];
  $user_not_found = TRUE;

  if (!empty($field_based_login['field'])) {

    $query = new EntityFieldQuery();
    $query->entityCondition('entity_type', 'user')
      ->fieldCondition($field_based_login['field'], 'value', $form_state['values']['name'], '=');
    $results = $query->execute();

    if ($results) {
      $user_not_found = FALSE;
      // Check for multiple records
      if (count($results['user']) > 1) {
        form_set_error('name', t('Sorry, Please contact administration. There are multiple user records found with same input.'));
        // todo : enter field information
        watchdog('user', 'Login attempt failed for %user. with field', array('%user' => $form_state['values']['name']));
      }
      else {
        $uid = array_keys($results['user'])[0];
        $name = db_query("SELECT name FROM {users} WHERE uid = :uid", array(':uid' => $uid))->fetchObject();
        $form_state['values']['name'] = $name->name;
      }
    }

    $user_load_by_name = user_load_by_name($form_state['values']['name']);
    if ($user_load_by_name && $allow_user_login_by_name) {
      $user_not_found = FALSE;
    }

    $user_load_by_mail = user_load_by_mail($form_state['values']['name']);
    if ($user_load_by_mail && $allow_user_login_by_email) {
      $user_not_found = FALSE;
      $form_state['values']['name'] = $user_load_by_mail->name;
    }

    if ($user_not_found) {
      form_set_error('name', t('Sorry, unrecognized username or password. <a href="@password">Have you forgotten your password?</a>', array('@password' => url('user/password', array('query' => array('name' => $form_state['values']['name']))))));
      watchdog('user', 'Login attempt failed for %user.', array('%user' => $form_state['values']['name']));
    }

  }
}

/**
 * Implements hook_field_attach_validate().
 */
function fbl_field_attach_validate($entity_type, $entity, &$errors) {

  $field_based_login = variable_get('field_based_login', array());
  if (!empty($field_based_login['field']) && $entity_type = 'user') {
    $available_fields = field_info_instances('user', 'user');
    $user_name = $entity->name;
    $user = user_load_by_name($user_name);
    foreach ($available_fields as $field_key => $field_info) {

      if ($field_based_login['field'] == $field_key) {

        $field_value = $entity->$field_key;
        foreach ($field_value[LANGUAGE_NONE] as $index => $value) {
          // code for unique check
          // todo validate '$value['value']' value
          $duplicate = _fbl_field_unique_check($field_based_login['field'], $user->uid, $value['value']);
          if ($duplicate) {
            form_set_error($field_key, t("Restricted to add this value which is already exists."));
          }

        }
      }
    }

  }

}

/*
 * Return true if field is duplicate
 */
function _fbl_field_unique_check($field, $uid, $value) {

  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'user')
    ->fieldCondition($field, 'value', $value, '=');
  $results = $query->execute();

  if ($results) {
    // if multiple records found then it is duplicate
    if (count($results['user']) > 1) {
      return TRUE;
    }
    elseif (count($results['user']) == 1) {
      // if this data is not belongs to him then its duplicate
      $data_uid = reset(array_keys($results['user']));
      if ($data_uid != $uid) {
        return TRUE;
      }
    }
  }

  return FALSE;
}
