<?php

/**
 * Implement hook_form_alter().
 *
 */
function field_based_login_form_alter(&$form, $form_state, $form_id) {
  if ($form_id == 'user_login_block' || $form_id == 'user_login') {
    $form['#validate'] = field_based_login_login_default_validators();
  }
}

/*
 * Callback function for user_login validator.
 */
function field_based_login_login_default_validators(){
  return array('field_based_login_login_name_validate','user_login_name_validate', 'user_login_authenticate_validate', 'user_login_final_validate');
}

/*
 * Custom validate function to check custom user field records.
 */
function field_based_login_login_name_validate($form, &$form_state){
  // todo : replace field_phone with configured unique field
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'user')
    ->fieldCondition('field_phone', 'value',$form_state['values']['name'], '=');
  $results = $query->execute();

  if($results){
    // Check for multiple records
    if(count($results['user']) > 1){
      form_set_error('name', t('Sorry, Please contact administration. There are multiple user records found with same input.'));
      // todo : enter field information
      watchdog('user', 'Login attempt failed for %user. with field', array('%user' => $form_state['values']['name']));
    }else{
      $uid = array_keys($results['user'])[0];
      $name = db_query("SELECT name FROM {users} WHERE uid = :uid", array(':uid' => $uid))->fetchObject();
      $form_state['values']['name'] = $name->name;
    }
  }else{
    form_set_error('name', t('Sorry, unrecognized username or password. <a href="@password">Have you forgotten your password?</a>', array('@password' => url('user/password', array('query' => array('name' => $form_state['values']['name']))))));
    watchdog('user', 'Login attempt failed for %user.', array('%user' => $form_state['values']['name']));
  }
}